# Copie para apps/api/.env (cp .env.example apps/api/.env) e ajuste.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mini_saas
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# Agente de IA (POST /chat). Provedores com API compatível com a OpenAI: groq | openai
LLM_PROVIDER=groq

# Groq (plano gratuito): crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (usada apenas com LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
